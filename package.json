{
  "name": "colorceil-mean",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "server:dev": "node --env-file-if-exists=.env --watch src/server/index.js",
    "build": "ng build",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "test:unit": "ng test --watch=false",
    "test:unit:watch": "ng test --watch",
    "test:unit:coverage": "ng test --watch=false --coverage",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "express": "^5.1.0",
    "mongoose": "^9.0.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.1.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.2",
    "@playwright/test": "^1.56.0",
    "mongodb-memory-server": "^10.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "type": "module"
}
