# Copy to .env. Use a local MongoDB or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/colorceil
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=
PORT=3000
APP_ORIGIN=http://localhost:4200
# Optional: password reset email. Without these, reset requests return an explicit 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set NODE_ENV=production and APP_ORIGIN to the HTTPS website origin when deploying.
